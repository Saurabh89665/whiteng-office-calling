# Office Sir Calling System - Server Configuration
# Copy this file to .env and fill in your values

# Server port (default: 3000)
PORT=3000

# Sir's login password - CHANGE THIS before deployment!
SIR_PASSWORD=office123

# Secret key for session tokens - CHANGE THIS before deployment!
SESSION_SECRET=changeme_use_a_long_random_string_here

# Environment (development or production)
NODE_ENV=development

# Allowed origins for CORS (comma-separated, or * for all)
# In production, set this to your Electron app's exact origin or *
CORS_ORIGIN=*
